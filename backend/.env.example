# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/leadgen_db?schema=public"

# Data Enrichment API Keys (Waterfall model)
APOLLO_API_KEY="your_apollo_api_key_here"
HUNTER_API_KEY="your_hunter_api_key_here"

# SMTP Email Notification Credentials (Nodemailer Gmail SMTP)
SMTP_USER="your_gmail_user_here@gmail.com"
SMTP_PASS="your_gmail_app_password_here"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# IMAP Inbound Email Listener Configuration (Hostinger / custom IMAP)
IMAP_USER="your_imap_user_here"
IMAP_PASSWORD="your_imap_password_here"
IMAP_HOST="imap.hostinger.com"
IMAP_PORT=993
IMAP_TLS=true

# Webhook Verification Tokens
WEBHOOK_TOKEN="your_webhook_verification_token_here"
